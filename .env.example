# Copy to .env.local. The game runs without any of these.

# Optional Postgres. When unset, games save as JSON under .data/.
# DATABASE_URL=postgresql://wealthquest:wealthquest@localhost:5432/wealthquest

# Auth.js / next-auth. The local demo password is always "playlocal".
# AUTH_SECRET=replace-with-a-long-random-string
# NEXTAUTH_SECRET=replace-with-a-long-random-string
# NEXTAUTH_URL=http://localhost:3000

# Branding
# NEXT_PUBLIC_BRAND_NAME=WealthQuest
# NEXT_PUBLIC_BRAND_PRODUCT=WealthQuest 3D
# NEXT_PUBLIC_BRAND_TAGLINE=Turn a paycheck into a story about cash flow.

# Set to "false" to hide private rooms.
# NEXT_PUBLIC_MULTIPLAYER_ENABLED=true

# Override the file-save directory.
# GAME_DATA_DIR=.data
